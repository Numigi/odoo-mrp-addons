<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_cost_analysis" model="ir.ui.view">
        <field name="name">product.template.form.inherit.cost.analysis</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                 <field name="bom_count" invisible="1"/>
                 <button name="action_view_cost_analysis_template" type="object"
                         class="oe_stat_button" icon="fa-dollar" string="Cost Analysis"
                         attrs="{'invisible': [('bom_count', '=', 0)]}"
                         groups="mrp.group_mrp_user"/>
            </div>
        </field>
    </record>
</odoo>
